node_modules/
/web/dist/
/web/test-results/
coverage/
*.log
.zcode/
design_system_output.txt
diff-trans.txt
*.exe
*.test
/.tmp-*
/data/
/tmp/
/start.bat
/gen.go
/console.log*
/nul*

# Runtime secrets: .env holds the master key, admin password and XApi URL.
# Never commit it; .env.example stays tracked as the template.
.env
!/.env.example

# Local SQLite databases and their WAL sidecars (runtime data, may hold secrets).
*.db
*.db-wal
*.db-shm

# Editor/OS backup copies of the built binary (e.g. nvidia-router.exe~).
*.exe~

# Stale embedded-frontend snapshots left by dist rebuilds.
/internal/web/dist.stale-*/

# Local credential dumps (NVIDIA keys, account exports). Never commit.
/key/

# Ad-hoc build/test transcripts that escape the *.log rule.
log_*.txt

# One-off remote diagnostics may contain runtime-only connection details.
# Reusable product checks stay as tracked shell/Go/TypeScript tests.
# Archived one-offs live under scripts/test/_archive/ and stay ignored.
__pycache__/
*.pyc
/scripts/test/_archive/
/scripts/test/__pycache__/

/internal/web/dist/*
!/internal/web/dist/
!/internal/web/dist/index.html
!/internal/web/dist/assets/
.worktrees/
